{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "codex-musicae": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/build/",
                "output": "assets/pdfjs-dist/build"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/cmaps/",
                "output": "assets/pdfjs-dist/cmaps"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/standard_fonts/",
                "output": "assets/pdfjs-dist/standard_fonts"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/wasm/",
                "output": "assets/pdfjs-dist/wasm"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/image_decoders/",
                "output": "assets/pdfjs-dist/image_decoders"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/iccs/",
                "output": "assets/pdfjs-dist/iccs"
              },
              {
                "glob": "opencv.js",
                "input": "node_modules/@techstark/opencv-js/dist/",
                "output": "assets/opencv"
              }
            ],
            "allowedCommonJsDependencies": [
              "pako"
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "codex-musicae:build:production"
            },
            "development": {
              "buildTarget": "codex-musicae:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
