{
  "name": "codex-musicae",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/generate-version.mjs && node scripts/generate-index-metadata.mjs && ng serve",
    "build": "ng build",
    "prebuild": "node scripts/generate-version.mjs && node scripts/generate-index-metadata.mjs",
    "pretest": "node scripts/generate-version.mjs",
    "watch": "node scripts/generate-index-metadata.mjs && ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "lint": "eslint . && node scripts/check-templates.mjs && node scripts/check-static-compliance.mjs",
    "lint:selftest": "node scripts/lint-selftest.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.4.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "angular-eslint": "^22.6.0",
    "eslint-plugin-boundaries": "^7.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.0.8"
  }
}
